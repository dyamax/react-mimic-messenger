{
  "name": "middle.messenger.praktikum.yandex",
  "version": "0.0.0",
  "private": true,
  "description": "The project is a starter layout for a messenger-style web application. It includes several static pages and Handlebars templates, uses TypeScript modules for better code structure, and PostCSS with autoprefixer alongside CSSnano for optimized styling. The build is configured with Vite for fast development and bundling.",
  "homepage": "https://myselfwebdemo.github.io/messenger-personal/",
  "bugs": {
    "url": "https://github.com/myselfwebdemo/messenger-personal/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/myselfwebdemo/messenger-personal.git"
  },
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "eslint.config.js",
  "scripts": {
    "start": "vite --host --port 3000",
    "dev": "vite --host --port 3000",
    "build": "tsc && vite build",
    "preview": "vite preview --port 3000",
    "lint:ts": "tsc --noEmit",
    "lint:js": "eslint src --ext .ts,.js",
    "lint:css": "stylelint \"**/*.css\"",
    "lint": "npm run lint:ts && npm run lint:js && npm run lint:css",
    "test": "mocha",
    "prepare": "husky"
  },
  "dependencies": {
    "handlebars": "^4.7.8",
    "jsdom": "^27.2.0",
    "leaflet": "^1.9.4",
    "vite-plugin-handlebars": "^1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/chai": "^5.2.3",
    "@types/handlebars": "^4.0.40",
    "@types/jsdom": "^27.0.0",
    "@types/leaflet": "^1.9.21",
    "@types/mocha": "^10.0.10",
    "@types/sinon": "^21.0.0",
    "@types/xmlhttprequest": "^1.8.2",
    "@typescript-eslint/eslint-plugin": "^8.48.1",
    "@typescript-eslint/parser": "^8.48.1",
    "autoprefixer": "^10.4.22",
    "chai": "^6.2.1",
    "cssnano": "^7.1.2",
    "eslint": "^9.39.1",
    "handlebars": "4.7.8",
    "husky": "^9.1.7",
    "mocha": "^11.7.5",
    "postcss": "^8.5.6",
    "postcss-cli": "^11.0.1",
    "sinon": "^21.0.0",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~5.8.3",
    "vite": "^7.2.6",
    "xmlhttprequest": "^1.8.0"
  },
  "engines": {
    "node": "22.14.0"
  }
}
